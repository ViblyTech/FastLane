NEXT_PUBLIC_SITE_URL=https://fastlanedetailingbend.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=fastlanedetailingbend.com

RESEND_API_KEY=
QUOTE_TO_EMAIL=team@fastlanedetailingbend.com
QUOTE_FROM_EMAIL="Fast Lane Detailing <quotes@fastlanedetailingbend.com>"

# Zapier — quote form submissions POST a JSON payload to this webhook URL
# in parallel with the email send. Get this from Zapier:
#   1. New Zap → Trigger: "Webhooks by Zapier" → Event: "Catch Hook"
#   2. Copy the "Webhook URL" Zapier shows you
#   3. Paste it here and redeploy
# Leave empty to disable.
ZAPIER_WEBHOOK_URL=
