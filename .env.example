NEXT_PUBLIC_SITE_URL=https://www.fastlanedetailing.net
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=fastlanedetailing.net

RESEND_API_KEY=
QUOTE_TO_EMAIL=team@fastlanedetailing.net
QUOTE_FROM_EMAIL="Fast Lane Detailing <quotes@fastlanedetailing.net>"

# Zapier — quote form submissions POST a JSON payload to this webhook URL
# in parallel with the email send. Get this from Zapier:
#   1. New Zap → Trigger: "Webhooks by Zapier" → Event: "Catch Hook"
#   2. Copy the "Webhook URL" Zapier shows you
#   3. Paste it here and redeploy
# Leave empty to disable.
ZAPIER_WEBHOOK_URL=

# Google Tag Manager / Google Analytics
# GTM container ID is hardcoded in src/lib/site.ts (analytics.gtm).
# Set these env vars to override the hardcoded value, OR to additionally
# fire a GA4 / Google Ads tag without GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
